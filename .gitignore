# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/master/Unity.gitignore
#
# *.meta files can be useful sometimes, so this might need tweaking

# Logs
/[Ll]ogs/
/[Ll]og/
*.log

# Autogenerated VS/MD2015 config files
.vs/
.vscode/

# Build results
[Bb]in/
[Oo]bj/
[Bb]uild/
[Bb]uilds/

# Visual Studio cache directory
.vs/

# Autogenerated by VS/MD to store aspect ratio info
AspNetCore.ProvideFeature/

# Rider files
.idea/
*.sln.iml

#Build folder
/[Bb]uild_*/
/[Bb]uildServer/

# Autogenerated by Unity in the Assets/StreamingAssets folder to speed up Git data transfer
/[Aa]ssets/StreamingAssets/UnityFS-*.fslib

# Autogenerated Jetbrains metadata
.idea/

# Autogenerated VS/MD generated C# project
*.csproj
*.unityproj
*.sln

# Autogenerated by VS/MD
*.DotSettings
*.DotSettings.user

# Autogenerated files
ExportedObj/
.exvs/

# Mono-specific
mono_crash.mem*

# Unity3D generated meta files
*.pidb.meta

# Unity3D Generated File On Crash Reports
sysinfo.txt
crash.dmp

# Builds
*.apk
*.aab
*.unitypackage

# Crash dumps
crashes/
crash_*

# Temporary directories (used by package manager)
ignoredassets/

# Test-specific
Tests/
Test*/

# OS-specific
.DS_Store
Thumbs.db

# IDE settings
.DS_Store
.AppleDouble
.LSOverride

# Environment files
.env
.env.local
.env.*.local

# IDE files
.sublime-project
.sublime-workspace
*.swp
*.swo
*~
.project
.classpath
.c9/

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*~.nib
